---
import Layout from '../layouts/Layout.astro';
import HomeServicesSection from '../components/home/HomeServicesSection.astro';
import HomeReviewsSection from '../components/home/HomeReviewsSection.astro';
import HeroScrollEffect from '../components/home/HeroScrollEffect.astro';
import HomeScrollDrive from '../components/home/HomeScrollDrive.astro';
---

<Layout
  title="Mobile Car Detailing Suffolk County LI | Drive Clean"
  description="Drive Clean offers mobile car detailing in Suffolk County & Long Island, NY. Exterior wash, interior detail, paint care & more. Book online — we come to you."
  theme="dark"
>
  <div class="home-page">
    <section
      class="hero hero--fixed fixed inset-0 z-0 flex h-svh flex-col items-center justify-center overflow-hidden px-4"
      aria-label="Drive Clean Mobile Detailing"
    >
      <div class="hero__media absolute inset-0 bg-black" aria-hidden="true">
        <img
          src="/images/hero-car.png"
          alt=""
          width={1024}
          height={716}
          class="hero__image"
          fetchpriority="high"
          decoding="async"
        />
        <div
          class="hero__overlay absolute inset-0 bg-gradient-to-b from-black/50 via-black/70 to-black"
        />
        <div
          class="hero__vignette absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,black_75%)]"
        />
        <div class="hero__shade absolute inset-0 bg-black/45" aria-hidden="true"></div>
      </div>

      <div class="hero__content relative z-10 mx-auto max-w-4xl text-center">
        <div class="hero__copy">
          <img
            src="/images/logo-car.png"
            alt=""
            width={280}
            height={158}
            class="hero__logo mx-auto mb-6 h-16 w-auto sm:mb-7 sm:h-20 md:h-24"
            decoding="async"
          />
          <p
            class="hero__eyebrow mb-4 text-xs font-medium uppercase tracking-[0.35em] text-white/60 sm:text-sm"
          >
            Long Island · Mobile Service
          </p>
          <h1
            class="hero__title text-4xl font-light leading-[1.1] tracking-tight text-white sm:text-5xl md:text-6xl lg:text-7xl"
          >
            Drive Clean Mobile <span class="font-bold text-red-600">Detailing</span> Service
          </h1>
          <p
            class="hero__tagline mx-auto mt-6 max-w-xl text-base leading-relaxed text-white/75 sm:text-lg md:text-xl"
          >
            Showroom-grade results, delivered to your driveway. Book online in minutes.
          </p>
        </div>
        <div
          class="hero__actions mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
        >
          <a
            href="/book"
            class="inline-block min-w-[200px] rounded-full border border-white/90 bg-white px-8 py-3.5 text-sm font-semibold uppercase tracking-wider text-black transition hover:bg-white/90"
          >
            Book now
          </a>
          <a
            href="#services"
            class="inline-block min-w-[200px] rounded-full border border-white/30 px-8 py-3.5 text-sm font-semibold uppercase tracking-wider text-white/90 transition hover:border-white/60 hover:text-white"
          >
            View services
          </a>
        </div>
      </div>

      <a
        href="#services"
        class="hero__scroll absolute bottom-8 left-1/2 z-10 -translate-x-1/2 text-white/40 transition hover:text-white/70"
        aria-label="Scroll to services"
        style="opacity: var(--hero-scroll-hint, 1)"
      >
        <span class="block text-[10px] uppercase tracking-[0.3em]">Explore</span>
        <svg
          class="mx-auto mt-2 h-5 w-5 animate-bounce"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </section>

    <div class="home-scroll relative z-10 mt-[100svh]">
      <div
        class="home-sheet home-sheet--services relative z-10 overflow-hidden rounded-t-[2rem] bg-black shadow-[0_-40px_80px_rgba(0,0,0,0.95)] ring-1 ring-inset ring-white/10 sm:rounded-t-[2.5rem]"
      >
        <div
          class="pointer-events-none absolute inset-x-0 top-0 z-20 flex justify-center pt-3"
          aria-hidden="true"
        >
          <div class="h-1 w-12 rounded-full bg-white/25" />
        </div>
        <HomeServicesSection />
      </div>

      <div
        class="home-sheet home-sheet--reviews relative rounded-t-[2rem] bg-red-700 shadow-[0_-32px_64px_rgba(127,29,29,0.55)] ring-1 ring-inset ring-white/15 sm:rounded-t-[2.5rem]"
      >
        <div class="relative overflow-hidden rounded-t-[2rem] sm:rounded-t-[2.5rem]">
          <div
            class="pointer-events-none absolute inset-x-0 top-0 z-20 flex justify-center pt-3"
            aria-hidden="true"
          >
            <div class="h-1 w-12 rounded-full bg-white/40" />
          </div>
          <HomeReviewsSection />
        </div>
      </div>
    </div>
  </div>

  <HeroScrollEffect />
  <HomeScrollDrive />
</Layout>

<style>
  /* No smooth scroll — it fights scroll-scrubbed tile reveals in Chrome */
  :global(html:has(.home-page)) {
    scroll-behavior: auto;
  }

  /* Initial state before HomeScrollDrive runs; JS sets opacity/transform each frame */
  :global(.home-page [data-scroll-fade]) {
    opacity: 0;
    transform: translate3d(-1.25rem, 2rem, 0);
    will-change: opacity, transform;
  }

  .hero--fixed {
    opacity: var(--hero-fade, 1);
  }

  .hero__media {
    transform: scale(var(--hero-scale, 1));
  }

  .hero__content {
    transform: translate3d(0, var(--hero-drift, 0), 0);
  }

  .hero__image {
    position: absolute;
    inset: 0;
    margin: auto;
    height: 100%;
    width: 100%;
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    object-position: center 42%;
    opacity: 0;
    transform: scale(1.06);
    animation: heroImageIn 4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Layered darken after image appears — text follows at 4.2s+ */
  .hero__overlay {
    opacity: 0;
    animation: heroOverlayIn 3.2s ease-out 0.8s forwards;
  }

  .hero__vignette {
    opacity: 0;
    animation: heroOverlayIn 3s ease-out 1.4s forwards;
  }

  .hero__shade {
    opacity: 0;
    animation: heroOverlayIn 2.8s ease-out 2s forwards;
  }

  .hero__copy > * {
    opacity: 0;
    transform: translateY(1.5rem);
    animation: heroTextIn 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 4.2s;
  }

  .hero__title {
    animation-delay: 4.55s;
  }

  .hero__tagline {
    animation-delay: 4.9s;
  }
  .hero__actions {
    opacity: 0;
    transform: translateY(1.5rem);
    animation: heroTextIn 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 6.2s;
  }

  .hero__scroll {
    opacity: 0;
    animation: heroTextIn 1.2s ease-out forwards;
    animation-delay: 7.2s;
  }

  @keyframes heroImageIn {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes heroOverlayIn {
    to {
      opacity: 1;
    }
  }

  @keyframes heroTextIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.home-page [data-scroll-fade]) {
      opacity: 1 !important;
      transform: none !important;
    }

    .hero--fixed {
      position: relative !important;
      height: auto !important;
      min-height: 100svh;
    }

    .home-scroll {
      margin-top: 0 !important;
    }

    .home-sheet {
      border-radius: 0;
      box-shadow: none;
    }

    .hero__image,
    .hero__overlay,
    .hero__vignette,
    .hero__shade,
    .hero__copy > *,
    .hero__actions,
    .hero__scroll {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
