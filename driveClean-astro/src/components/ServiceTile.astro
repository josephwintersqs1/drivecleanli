---
import {
  formatDurationFromMinutes,
  formatPrice,
  getServiceImage,
  type ServicePackage,
} from '../data/services';

interface Props {
  service: ServicePackage;
  variant?: 'dark' | 'light';
  /** Scroll-linked reveal on homepage */
  scrollReveal?: boolean;
  tileIndex?: number;
}

const { service, variant = 'dark', scrollReveal = false, tileIndex = 0 } = Astro.props;
const imageSrc = getServiceImage(service.id);
const isDark = variant === 'dark';
---

<article
  class:list={[
    'service-tile group flex flex-col overflow-hidden rounded-2xl',
    scrollReveal
      ? 'transition-[border-color,background-color]'
      : 'transition',
    isDark
      ? 'border border-white/10 bg-white/[0.03] hover:border-red-600/40 hover:bg-white/[0.06]'
      : 'border border-slate-200 bg-white hover:border-red-500/50 hover:shadow-lg',
  ]}
  {...scrollReveal && {
    'data-scroll-fade': true,
    'data-tile-index': String(tileIndex),
  }}
>
  <div class="service-tile__media relative aspect-[4/3] overflow-hidden bg-zinc-900">
    <img
      src={imageSrc}
      alt={`${service.name} — Drive Clean mobile detailing`}
      width={640}
      height={480}
      class="service-tile__img h-full w-full object-cover"
      loading="lazy"
    />
    <div
      class:list={[
        'pointer-events-none absolute inset-0',
        isDark
          ? 'bg-gradient-to-t from-black/80 via-black/20 to-transparent'
          : 'bg-gradient-to-t from-slate-900/70 via-transparent to-transparent',
      ]}
      aria-hidden="true"
    />
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <h3 class="text-lg font-semibold leading-snug">
      <a
        href={`/book?service=${service.id}`}
        data-book-transition
        class="text-red-600 transition hover:text-red-500"
      >
        {service.name}
      </a>
    </h3>
    <p
      class:list={[
        'mt-2 flex-1 text-sm leading-relaxed',
        isDark ? 'text-white/60' : 'text-slate-600',
      ]}
    >
      {service.description}
    </p>
    <dl class="mt-4 flex items-center justify-between gap-4 text-sm">
      <div>
        <dt class="sr-only">Duration</dt>
        <dd class={isDark ? 'text-white/50' : 'text-slate-500'}>
          {formatDurationFromMinutes(service.baseDurationMinutes)}
        </dd>
      </div>
      <div class="text-right">
        <dt class="sr-only">Starting price</dt>
        <dd>
          <span class={isDark ? 'text-white/50' : 'text-slate-500'}>From </span>
          <span class="text-lg font-bold text-red-500">
            {formatPrice(service.fromPrice)}
          </span>
        </dd>
      </div>
    </dl>
    <a
      href={`/book?service=${service.id}`}
      data-book-transition
      class:list={[
        'mt-5 block rounded-full py-2.5 text-center text-xs font-semibold uppercase tracking-wider transition',
        isDark
          ? 'border border-white/25 text-white group-hover:border-red-600 group-hover:bg-red-600 group-hover:text-white'
          : 'border border-slate-300 text-slate-800 group-hover:border-red-600 group-hover:bg-red-600 group-hover:text-white',
      ]}
    >
      Request to book
    </a>
  </div>
</article>

<style>
  .service-tile__img {
    filter: grayscale(100%);
    transition: filter 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-tile:hover .service-tile__img,
  .service-tile:focus-within .service-tile__img {
    filter: grayscale(0%);
  }

  /* Zoom lives on media box so it never fights scroll-reveal transforms */
  .service-tile__media {
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-tile:hover .service-tile__media,
  .service-tile:focus-within .service-tile__media {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-tile__img {
      filter: grayscale(0%);
      transition: none;
    }
    .service-tile__media {
      transition: none;
    }
    .service-tile:hover .service-tile__media,
    .service-tile:focus-within .service-tile__media {
      transform: none;
    }
  }
</style>
