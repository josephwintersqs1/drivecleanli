---
import { services } from '../../data/services';
import ServiceTile from '../ServiceTile.astro';
---

<section
  id="services"
  data-scroll-block="services"
  class="home-services-section bg-black px-4 pb-28 pt-20 sm:pb-32 sm:pt-24"
  aria-labelledby="home-services-heading"
>
  <div class="mx-auto max-w-6xl">
    <header class="mx-auto max-w-3xl text-center">
      <p
        data-scroll-fade
        data-scroll-intro="0"
        class="text-xs font-semibold uppercase tracking-[0.3em] text-red-600"
      >
        What we offer
      </p>
      <h2
        id="home-services-heading"
        data-scroll-fade
        data-scroll-intro="1"
        class="mt-3 text-3xl font-light tracking-tight text-white sm:text-4xl md:text-5xl"
      >
        Mobile car detailing services in <span class="font-bold text-red-600">Suffolk County</span>
      </h2>
      <p
        data-scroll-fade
        data-scroll-intro="2"
        class="mt-5 text-base leading-relaxed text-white/65 sm:text-lg"
      >
        Drive Clean brings professional hand wash, interior restoration, paint care, and
        specialty treatments to your home or workplace across Long Island, NY. Choose a
        package below and book online — we come to you.
      </p>
    </header>

    <div id="services-grid" class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, index) => (
          <ServiceTile service={service} variant="dark" scrollReveal tileIndex={index} />
        ))
      }
    </div>

    <div data-scroll-fade data-scroll-cta class="mt-14 flex justify-center">
      <a
        href="/book"
        class="inline-block min-w-[220px] rounded-full bg-red-600 px-8 py-3.5 text-center text-sm font-semibold uppercase tracking-wider text-white transition hover:bg-red-700"
      >
        Book now
      </a>
    </div>
  </div>
</section>
