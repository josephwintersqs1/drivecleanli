# Square
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Google Calendar (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Site URL for Square redirect after payment
SITE_URL=http://localhost:4321

# Google Analytics (GA4) — site-wide via Layout.astro
PUBLIC_GA_MEASUREMENT_ID=G-ZGDPN87L22

# Resend — booking confirmation & reminder emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=DriveClean <services@drivecleanli.com>
CRON_SECRET=

# Google address autocomplete — one browser key; enable BOTH APIs in Cloud Console:
#   Maps JavaScript API
#   Places API (New)
PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional (same key); used only if PUBLIC_GOOGLE_MAPS_API_KEY is empty
PUBLIC_GOOGLE_PLACES_API_KEY=
